# прежняя раскладка: папка данных внутри проекта (data/) — на случай, если она там окажется; ничего из неё не в git
/data/secrets/
/data/logs/
/data/inbox/*
!/data/inbox/README.md
/data/photos/
/data/photos_old/
.DS_Store
__pycache__/

# data.js — сырые таблицы для страниц; пишет приложение в папку данных
/data/data.js

# приложение: зависимости и сборки
/desktop/node_modules/
# ключи приложений, которые кладёт сборка (и копии «… 2.json», которые делает синхронизация «Документов»)
/desktop/*_app*.json
/dist/

# данные — вне проекта, в папке из настроек приложения (~/Documents/Здоровье/data), без git
/data/

# личное для Claude (цели, разборы) — только локально
/CLAUDE.local.md
