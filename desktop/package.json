{
  "name": "sleep-eat-lift",
  "productName": "SEL",
  "version": "1.3.0",
  "description": "SEL (sleep · eat · lift) — питание, вес, сон, восстановление и тренировки из FatSecret и Whoop",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "release": "node scripts/release.js",
    "dist:mac": "node scripts/prepare.js && electron-builder --mac -c.directories.output=\"$HOME/Library/Caches/sleep-eat-lift-build\" && node scripts/collect.js",
    "app:mac": "npm run dist:mac && node scripts/install.js",
    "dist:win": "node scripts/prepare.js && electron-builder --win -c.directories.output=\"$HOME/Library/Caches/sleep-eat-lift-build\" && node scripts/collect.js"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.health.app",
    "productName": "SEL",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "store.js",
      "protocol.js",
      "oauthwin.js",
      "fatsecret.js",
      "whoop.js",
      "updater.js",
      "settings.js",
      "photosfs.js",
      "pyround.js",
      "keys.js",
      "datadir.js",
      "profiles.js",
      "alcohol.js",
      "secrets.js",
      "changelog.js",
      "whatsnew.js",
      "menu.js",
      "CHANGELOG.md",
      "root_readme.md",
      "schema.json",
      "data_readme.md",
      "fatsecret_app.json",
      "whoop_app.json"
    ],
    "extraResources": [
      {
        "from": "../portal",
        "to": "portal",
        "filter": [
          "**/*",
          "!data.js"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.healthcare-fitness",
      "artifactName": "SEL-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SEL-${version}-win-${arch}.${ext}"
    },
    "afterPack": "scripts/afterpack.js"
  }
}
